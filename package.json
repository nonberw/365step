{
  "name": "rostok",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c red,gray \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "ai:check": "tsx scripts/ai-smoke.ts",
    "check:content": "tsx scripts/check-content.ts",
    "build:server": "esbuild server/app.ts --bundle --platform=node --format=esm --target=node24 --packages=external --outfile=server-dist/app.mjs",
    "vercel-build": "vite build && npm run build:server"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@bdelab/jscat": "^5.3.2",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@libsql/client": "^0.18.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tailwindcss/vite": "^4.3.3",
    "@uiw/react-codemirror": "^4.25.12",
    "@vercel/blob": "^2.8.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "framer-motion": "^14.9.0",
    "katex": "^0.19.1",
    "lucide-react": "^1.62.0",
    "mammoth": "^1.13.0",
    "motion": "^14.7.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "react-wrap-balancer": "^1.1.1",
    "replicad": "^1.2.0",
    "replicad-opencascadejs": "^1.1.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "ts-fsrs": "^6.0.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/express": "^5.0.6",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": "24.x"
  }
}
